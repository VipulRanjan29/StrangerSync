<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StrangerSync | Video Chat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/modern.css" />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.5/socket.io.js"
      integrity="sha512-luMnTJZ7oEchNDZAtQhgjomP1eZefnl82ruTH/3Oj/Yu5qYtwL7+dVRccACS/Snp1lFXq188XFipHKYE75IaQQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <style>
      .chat-text-area {
        height: 120px;
        overflow-y: auto;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 14px;
      }
      .chat-text-area::-webkit-scrollbar {
        width: 4px;
      }
      .chat-text-area::-webkit-scrollbar-thumb {
        background: var(--glass-border);
        border-radius: 10px;
      }
      .next-chat {
        cursor: pointer;
      }
      .control-btn svg {
        width: 20px;
        height: 20px;
      }
      .sidebar {
         padding-top: 20px;
      }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <div style="display: flex; align-items: center; gap: 12px; cursor: pointer;" onclick="window.location.href='/'">
        <div style="width: 40px; height: 40px; background: var(--gradient-primary); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        </div>
        <h2 style="font-weight: 800; letter-spacing: -1px;">StrangerSync</h2>
      </div>
      
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="#">About</a>
        <a href="#">Safety</a>
        <a href="#">Premium</a>
      </div>
      
      <div class="auth-buttons">
        <% if (user) { %>
          <span style="color: var(--text-dim); font-size: 14px; margin-right: 16px;">Welcome, <b><%= user.username %></b></span>
          <button class="btn-outline" onclick="window.location.href='/logout'">Logout</button>
        <% } else { %>
          <button class="btn-outline" onclick="window.location.href='/login'">Sign in</button>
          <button class="btn-primary" onclick="window.location.href='/signup'">Sign up</button>
        <% } %>
      </div>
    </nav>

    <main class="app-container">
      <aside class="sidebar">
        <div class="online-count">
          <div class="dot"></div>
          <span>1,234+ people online</span>
        </div>
        
        <h1 style="font-size: 48px; line-height: 1.1; margin-bottom: 16px;">
          Meet new people from around the <span class="gradient-text">world</span>
        </h1>
        
        <p style="color: var(--text-dim); margin-bottom: 32px;">
          Start a random video chat and make a real connection.
        </p>
        
        <div style="display: flex; gap: 16px; margin-bottom: 16px;">
           <button class="btn-outline" style="flex: 1; justify-content: center; background: rgba(138, 79, 255, 0.1); border-color: var(--accent-purple);">
             <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
             Video Chat
           </button>
           <button class="btn-outline" style="flex: 1; justify-content: center;">
             <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
             Text Chat
           </button>
        </div>
        
        <button id="start-chat-btn" class="btn-primary" style="width: 100%; height: 56px; justify-content: center; font-size: 16px;">
          Start Video Chat
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 8px;"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        </button>
        
        <button class="btn-outline next-chat" style="width: 100%; margin-top: 12px; justify-content: center; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          Next Stranger
        </button>

        <div class="glass-card" style="margin-top: auto; padding: 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center;">
           <div>
             <div style="font-size: 18px; color: var(--accent-purple);">✦</div>
             <div style="font-size: 10px; font-weight: 600;">100% Free</div>
           </div>
           <div>
             <div style="font-size: 18px; color: var(--accent-purple);">👤</div>
             <div style="font-size: 10px; font-weight: 600;">No Registration</div>
           </div>
           <div>
             <div style="font-size: 18px; color: var(--accent-purple);">🛡️</div>
             <div style="font-size: 10px; font-weight: 600;">Safe & Secure</div>
           </div>
        </div>
      </aside>

      <section class="main-content">
        <div class="video-wrapper">
          <video id="user-2" class="remote-video" autoplay playsinline></video>
          
          <div class="local-video-pip">
            <video id="user-1" autoplay playsinline></video>
          </div>

          <!-- Stranger Info Overlay -->
          <div class="glass-card" style="position: absolute; top: 24px; left: 24px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; border-radius: 16px;">
            <div class="dot"></div>
            <div>
              <div style="font-size: 14px; font-weight: 700;">Stranger</div>
              <div style="font-size: 11px; color: var(--text-dim);">🇺🇸 United States</div>
            </div>
          </div>

          <button class="btn-outline" style="position: absolute; top: 24px; right: 24px; padding: 8px 16px; border-radius: 100px; font-size: 13px;">
            🚩 Report
          </button>

          <div class="video-controls">
            <button class="control-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg></button>
            <button class="control-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></button>
            <button class="control-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg></button>
            <button class="control-btn end-call next-chat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-3.33-2.67m-2.67-3.34a19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/></svg></button>
          </div>
        </div>

        <div class="chat-container glass-card" style="padding: 20px;">
          <div class="status-badge">
             <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
             Connection established
             <span style="color: var(--text-dim); margin-left: 8px; font-weight: 400;">You're now chatting with a random stranger.</span>
          </div>

          <div class="chat-text-area"></div>

          <div class="chat-input-wrapper">
            <input type="text" id="msg-input" placeholder="Type a message...">
            <div style="display: flex; gap: 8px; align-items: center; padding-right: 8px;">
               <button style="background: transparent; border: none; color: var(--text-dim); cursor: pointer;">😊</button>
               <button class="send-btn msg-send-button">
                 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(-45)"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
               </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script
      src="https://code.jquery.com/jquery-3.7.1.min.js"
      integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
      crossorigin="anonymous"
    ></script>
    <script src="/js/ui_enhancements.js"></script>
    <script src="/js/index.js"></script>
  </body>
</html>
